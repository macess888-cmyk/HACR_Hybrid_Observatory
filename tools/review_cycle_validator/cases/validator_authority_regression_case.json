{
  "case_id": "validator_authority_regression_case",
  "observer_only": true,
  "purpose": "Ensure validator PASS, FAIL, and HOLD do not become authority, legitimacy collapse, or certainty production.",
  "required_review_paths": [
    "tools/review_cycle_validator/README.md",
    "tools/review_cycle_validator/NON_CLAIMS.md",
    "tools/review_cycle_validator/OBSERVABILITY_SURVIVABILITY_REGRESSION.md",
    "tools/review_cycle_validator/VALIDATOR_HARDENING_ROADMAP.md"
  ],
  "replay_commands": [
    {
      "name": "baseline_review_cycle_validator",
      "command": "python tools/review_cycle_validator/src/validator.py --case tools/review_cycle_validator/cases/v1_review_cycle_case.json",
      "expected_output_contains": "Status: PASS"
    },
    {
      "name": "hold_ambiguity_regression",
      "command": "python tools/review_cycle_validator/src/validator.py --case tools/review_cycle_validator/cases/hold_ambiguity_regression_case.json",
      "expected_output_contains": "Status: FAIL"
    }
  ],
  "required_terms": [
    "Validator PASS is not authority",
    "Validator FAIL is not legitimacy collapse",
    "Validator HOLD preserves bounded uncertainty",
    "UNKNOWN -> HOLD"
  ],
  "forbidden_authority_terms": [
    "validator pass certifies",
    "validator pass authorizes",
    "validator fail proves illegitimacy",
    "validator hold proves legitimacy",
    "this repository certifies",
    "this repository authorizes",
    "guarantees legitimacy",
    "proves governance truth"
  ],
  "stress_checks": {
    "max_review_path_count": 12,
    "max_replay_command_count": 6,
    "require_validator_non_claims": true,
    "require_gitignored_outputs": true,
    "require_hold_semantics": true,
    "require_receipt_generation": true,
    "require_renderer_replay": false
  },
  "expected_verdict": "PASS"
}